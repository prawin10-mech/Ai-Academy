# Copy to .env.local for development. In production set these in the Vercel project settings.

# Required in production
MONGODB_URI=                 # MongoDB Atlas connection string
MONGODB_DB=ai_academy
SESSION_SECRET=              # 32+ random characters, signs login cookies (openssl rand -hex 32)
CRON_SECRET=                 # long random string; the hourly job sends it as a Bearer token

# Site owner
ADMIN_EMAIL=                 # the account with this email sees site status and gets admin rights
APP_URL=https://your-app.vercel.app

# Telegram (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=       # without the @, used for the "Link Telegram" button
TELEGRAM_WEBHOOK_SECRET=     # random string, registered with scripts/set-webhook.mjs
TELEGRAM_CHAT_ID=            # your own chat id: owner alerts (new learners, job summary, errors, feedback)

# Optional
CRON_BUDGET_MS=45000
