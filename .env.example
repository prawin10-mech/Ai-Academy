# Copy to .env.local for development. In production set these in the Vercel project settings.

# Database. Leave empty in development to use a local JSON file (.data/academy.json).
MONGODB_URI=
MONGODB_DB=ai_academy

# Telegram bot (create with @BotFather, then message your bot once and read your chat id from @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shared secret to open the site and call the API. Pick a long random string.
ACCESS_KEY=

# Vercel Cron sends this as "Authorization: Bearer <value>". Vercel adds it automatically once the variable exists.
CRON_SECRET=

# Optional
TZ_NAME=Asia/Dubai
APP_URL=https://your-app.vercel.app
